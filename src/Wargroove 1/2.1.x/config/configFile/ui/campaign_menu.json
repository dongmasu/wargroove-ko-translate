        5,
        5
      ],
      "widget": {
        "class": "hybridList",
        "id": "menu",
        "options": [
          {
            "id": "difficulty",
            "if": [
              "!demo"
            ],
            "textKey": "ui_campaign_difficulty"
          },
          {
            "id": "options",
